.container{padding:20px}
.header{text-align:center;margin-bottom:20px}
.title{font-size:20px;font-weight:600}
.loading,.empty{text-align:center;color:#888;margin:20px 0}
.card{background:#fff;border-radius:8px;padding:12px;box-shadow:0 2px 8px rgba(0,0,0,.06);margin-bottom:12px}
.row{display:flex;justify-content:space-between;margin-bottom:6px}
.label{color:#666}
.value{color:#333}
.photo{width:100%;height:160px;border-radius:6px;margin-top:8px}
.footer{margin-top:20px;text-align:center}
